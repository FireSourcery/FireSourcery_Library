{
    // Shared library settings. IntelliSense: .vscode/c_cpp_properties.json (C/C++ extension) or a product's clangd setup. Spelling: .vscode/cspell.json.

    "files.associations": {
        "*.h": "c",
        // Both tools read comments; open them as JSON with comments
        "c_cpp_properties.json": "jsonc",
        "cspell.json": "jsonc",
    },
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "search.exclude": {
        "**/External": true,
    },

    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnPaste": false,
    "editor.indentSize": "tabSize",
    "editor.detectIndentation": false,
    "editor.rulers": [
        80,
        160,
        200,
    ],

    // C/C++ extension (cpptools). "C_Cpp.formatting" is left at default, which formats with .clang-format;
    // the vcFormat settings apply only with "C_Cpp.formatting": "vcFormat".
    "C_Cpp.doxygen.generatedStyle": "/*!",
    // "C_Cpp.formatting": "vcFormat",
    "C_Cpp.vcFormat.wrap.preserveBlocks": "allOneLineScopes",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.type": "newLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "newLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "newLine",
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyFunction": true,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyType": true,
    "C_Cpp.vcFormat.newLine.scopeBracesOnSeparateLines": true,
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "newLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.lambda": "newLine",
    "C_Cpp.vcFormat.newLine.beforeWhileInDoWhile": true,
    "C_Cpp.vcFormat.space.pointerReferenceAlignment": "center",
    "C_Cpp.vcFormat.space.aroundAssignmentOperator": "insert",
    "C_Cpp.vcFormat.space.beforeConstructorColon": false,
    "C_Cpp.vcFormat.space.afterKeywordsInControlFlowStatements": true,
    "C_Cpp.vcFormat.space.afterComma": true,
    "C_Cpp.vcFormat.space.removeBeforeSemicolon": true,
    "C_Cpp.vcFormat.space.insertAfterSemicolon": true,
    "C_Cpp.vcFormat.space.withinSquareBrackets": false,
    "C_Cpp.vcFormat.space.withinLambdaBrackets": true,
    "C_Cpp.vcFormat.space.removeAroundUnaryOperator": true,
    "C_Cpp.vcFormat.space.removeAroundMemberOperators": true,
    "C_Cpp.vcFormat.space.betweenEmptyBraces": false,
    "C_Cpp.vcFormat.space.beforeBlockOpenBrace": false,
    "C_Cpp.vcFormat.space.withinInitializerListBraces": true,
    "C_Cpp.vcFormat.space.beforeInitializerListOpenBrace": false,
    "C_Cpp.vcFormat.space.preserveInInitializerList": true,
    "C_Cpp.vcFormat.space.beforeLambdaOpenParenthesis": true,
    "C_Cpp.vcFormat.space.afterCastCloseParenthesis": false,
    "C_Cpp.vcFormat.space.withinCastParentheses": false,
    "C_Cpp.vcFormat.space.betweenEmptyLambdaBrackets": false,
    "C_Cpp.vcFormat.indent.multiLineRelativeTo": "innermostParenthesis",
    "C_Cpp.vcFormat.indent.lambdaBracesWhenParameter": false,
    "C_Cpp.vcFormat.indent.preserveWithinParentheses": false,
    "C_Cpp.vcFormat.indent.preprocessor": "oneLeft",
    "C_Cpp.vcFormat.indent.preserveComments": false,
    "C_Cpp.vcFormat.indent.accessSpecifiers": true,
    "C_Cpp.vcFormat.indent.caseLabels": true,
    "C_Cpp.vcFormat.indent.caseContents": true,
    "C_Cpp.vcFormat.indent.caseContentsWhenBlock": true,
}
